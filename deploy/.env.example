# Copie para deploy/.env na VPS e preencha. Esse arquivo não vai para o git.
# Para gerar segredos: openssl rand -hex 32

# Endereço do site. Com o sslip.io, troque os pontos do IP da VPS por hífens:
# IP 203.0.113.5 -> 203-0-113-5.sslip.io
# O frontend fica em https://DOMAIN e a API em https://api.DOMAIN.
DOMAIN=203-0-113-5.sslip.io

# Senha do Postgres (use só letras e números, ela entra numa URL).
POSTGRES_PASSWORD=

# Segredo dos tokens de login. Mínimo de 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=60

# Senhas das contas criadas pelo seed: o admin (login "admin") e os usuários
# de demonstração (mariana.albuquerque@example.com etc.).
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# E-mail pelo Gmail: SMTP_USER é o endereço Gmail e SMTP_PASSWORD a senha de
# app de 16 caracteres, sem espaços (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Moraê <seu-endereco@gmail.com>"
EMAIL_VERIFICATION_TTL_HOURS=24

# Opcionais.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_WEBHOOK_SECRET=
PAYMENT_TOKEN_ENCRYPTION_KEY=
MERCADO_PAGO_SANDBOX=true
