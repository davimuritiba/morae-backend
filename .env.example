PORT=3000
# Gere um valor exclusivo com node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=60
UPLOADS_DIR=./uploads

# Credenciais do NestJS Observe (https://observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

DATABASE_URL="postgresql://morae:morae@localhost:5432/morae?schema=public"

# Mercado Pago Marketplace (Checkout Pro)
# Gere uma chave de 32 bytes em base64 com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/payments/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_WEBHOOK_SECRET=
PAYMENT_TOKEN_ENCRYPTION_KEY=
# Seguro por padrão: use a URL de sandbox até validar a integração ponta a ponta.
MERCADO_PAGO_SANDBOX=true

# Opcional. Banco dos testes de integração (npm run test:int); o nome precisa
# terminar em _test. Se omitido, usa o banco do DATABASE_URL + "_test".
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/morae_test?schema=public"

# E-mail via SMTP. Os valores abaixo apontam para o Mailpit do
# docker-compose, que recebe tudo sem entregar (veja em http://localhost:8025).
# Em produção, use o SMTP do provedor e SMTP_SECURE=true se for a porta 465.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Moraê <nao-responda@morae.local>"

# Endereço do front-end. O link de verificação é <APP_WEB_URL>/verificar-email?token=...
APP_WEB_URL=http://localhost:5173
# Validade do link de verificação de e-mail, em horas.
EMAIL_VERIFICATION_TTL_HOURS=24
