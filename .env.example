PORT=3000

# Credenciais do NestJS Observe (https://observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/morae?schema=public"

# Opcional. Banco dos testes de integração (npm run test:int); o nome precisa
# terminar em _test. Se omitido, usa o banco do DATABASE_URL + "_test".
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/morae_test?schema=public"
