// Schema do banco do Moraê. Learn more: https://pris.ly/d/prisma-schema
//
// Convenções:
// - Ids são UUID gerados pelas entidades de domínio, por isso sem @default.
// - Nomes em camelCase no código e snake_case no banco (@map / @@map).
// - updatedAt também vem da entidade (método touch()), por isso sem @updatedAt.

generator client {
  provider            = "prisma-client"
  output              = "../src/shared/infra/database/generated/prisma"
  // O projeto é ESM com moduleResolution "nodenext", que exige extensão .js
  // nos imports relativos do client gerado.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Permission {
  VERIFY_DOCUMENTS
  MODERATE_LISTINGS
  MANAGE_USERS
  VIEW_REPORTS
}

enum HousingType {
  APARTMENT
  HOUSE
  ROOM
  REPUBLIC
}

enum ListingStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum ContractType {
  MONTHLY_RENTAL
  PROPERTY_SHARING
  SEASONAL
}

enum MinimumStay {
  NO_MINIMUM
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum ChatType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

// ─── Módulo user ────────────────────────────────────────────────────────────

model User {
  id            String        @id @db.Uuid
  name          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(254)
  // Só os 11 dígitos, como o VO Cpf guarda.
  cpf           String        @unique @db.Char(11)
  passwordHash  String        @map("password_hash")
  // DDD + número, sem código do país (VO Phone).
  phone         String?       @db.VarChar(11)
  photoUrl      String?       @map("photo_url") @db.VarChar(2048)
  emailVerified Boolean       @default(false) @map("email_verified")
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @map("updated_at") @db.Timestamptz(3)

  student                 Student?
  propertyOwner           PropertyOwner?
  administrator           Administrator?
  propertyCohabitancies   PropertyCohabitant[]
  emailVerificationTokens EmailVerificationToken[]
  createdChats            Chat[]
  chatParticipations      ChatParticipant[]
  sentMessages            Message[]
  favorites               Favorite[]
  interests               Interest[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

// Token de uso único para confirmar o e-mail. Só o hash do token (SHA-256 em
// hexadecimal, 64 caracteres) é guardado; o token em si vai apenas no link.
model EmailVerificationToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Student {
  id                 String             @id @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  enrollmentNumber   String             @unique @map("enrollment_number") @db.VarChar(15)
  course             String             @db.VarChar(100)
  period             Int                @db.SmallInt
  expectedGraduation DateTime           @map("expected_graduation") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(3)

  user    User            @relation(fields: [userId], references: [id])
  profile StudentProfile?

  @@map("students")
}

// Faz parte do agregado Student: é salvo junto e apagado junto (Cascade).
model StudentProfile {
  id              String   @id @db.Uuid
  studentId       String   @unique @map("student_id") @db.Uuid
  bio             String   @db.VarChar(500)
  income          Decimal? @db.Decimal(10, 2)
  // BudgetRange do domínio vira duas colunas.
  minBudget       Decimal  @map("min_budget") @db.Decimal(10, 2)
  maxBudget       Decimal  @map("max_budget") @db.Decimal(10, 2)
  isSmoker        Boolean  @map("is_smoker")
  noisePreference Int      @map("noise_preference") @db.SmallInt
  visitPreference Int      @map("visit_preference") @db.SmallInt
  // WeeklySchedule: { "MONDAY": [{ "start": "08:00", "end": "12:00" }], ... }
  schedule        Json     @default("{}")
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model PropertyOwner {
  id                 String             @id @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id])
  properties Property[]

  @@map("property_owners")
}

model Administrator {
  id           String       @id @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  login        String       @unique @db.VarChar(100)
  passwordHash String       @map("password_hash")
  permissions  Permission[] @default([])
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("administrators")
}

// ─── Módulo property ────────────────────────────────────────────────────────

model Residence {
  id           String   @id @db.Uuid
  postalCode   String   @map("postal_code") @db.Char(8)
  state        String   @db.Char(2)
  street       String   @db.VarChar(150)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(100)
  city         String   @db.VarChar(100)
  neighborhood String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  property Property?

  @@map("residences")
}

model Property {
  id            String      @id @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  residenceId   String      @unique @map("residence_id") @db.Uuid
  housingType   HousingType @map("housing_type")
  bedrooms      Int         @db.SmallInt
  bathrooms     Int         @db.SmallInt
  parkingSpaces Int         @default(0) @map("parking_spaces") @db.SmallInt
  amenities     String[]    @default([])
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @map("updated_at") @db.Timestamptz(3)

  owner       PropertyOwner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  residence   Residence            @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  cohabitants PropertyCohabitant[]
  listings    Listing[]

  // Criado pela migration restore_property_owner; declarado aqui para o
  // Prisma não removê-lo nas próximas migrations.
  @@index([ownerId])
  @@map("properties")
}

model PropertyCohabitant {
  propertyId String   @map("property_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([propertyId, userId])
  @@index([userId])
  @@map("property_cohabitants")
}

model Listing {
  id           String        @id @db.Uuid
  propertyId   String        @map("property_id") @db.Uuid
  title        String        @db.VarChar(90)
  description  String        @db.VarChar(1000)
  rules        String?       @db.VarChar(500)
  rent         Decimal       @db.Decimal(10, 2)
  condominium  Decimal?      @db.Decimal(10, 2)
  contractType ContractType  @map("contract_type")
  minimumStay  MinimumStay   @map("minimum_stay")
  status       ListingStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(3)

  property  Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  media     ListingMedia[]
  messages  Message[]
  favorites Favorite[]
  interests Interest[]

  @@index([propertyId])
  @@index([status])
  @@map("listings")
}

model ListingMedia {
  id        String    @id @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  type      MediaType
  url       String    @db.VarChar(2048)
  position  Int       @default(0) @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
  @@map("listing_media")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favorites")
}

model Interest {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId, createdAt(sort: Desc)])
  @@map("interests")
}

// ─── Módulo interaction: chat ───────────────────────────────────────────────

model Chat {
  id            String    @id @db.Uuid
  type          ChatType
  name          String?   @db.VarChar(60)
  createdBy     String    @map("created_by") @db.Uuid
  // Só em DIRECT: os dois userIds em ordem ("a:b"), uma conversa por par.
  directKey     String?   @unique @map("direct_key") @db.VarChar(80)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)

  creator      User              @relation(fields: [createdBy], references: [id])
  participants ChatParticipant[]
  messages     Message[]

  @@map("chats")
}

model ChatParticipant {
  chatId     String          @map("chat_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  role       ParticipantRole
  joinedAt   DateTime        @map("joined_at") @db.Timestamptz(3)
  lastReadAt DateTime?       @map("last_read_at") @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id        String   @id @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  content   String?  @db.VarChar(2000)
  listingId String?  @map("listing_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  chat    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([listingId])
  @@map("messages")
}
